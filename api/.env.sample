STAGE=local
NODE_ENV=development
PORT=9100

JWT_SECRET=
JWT_EXPIRES_IN=
JWT_ISSUER=
JWT_AUDIENCE=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/kidslearn?connection_limit=10&pool_timeout=20

CORS_ORIGIN=http://localhost:3000

SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Yuklangan fayl manzili shu prefiks bilan yasaladi va bazaga saqlanib
# qoladi, shuning uchun tashqaridan ochiladigan manzil bo'lishi kerak.
PUBLIC_API_URL=

# Matn ovozga aylantirish. Kalit bo'sh bo'lsa TTS o'chadi (ilova ishlayveradi,
# faqat yozib olingan audio chalinadi). Azure tanlangan sabab — unda o'zbek
# neural ovozlari bor (uz-UZ-MadinaNeural / uz-UZ-SardorNeural).
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_VOICE_UZ=uz-UZ-MadinaNeural
TTS_VOICE_RU=ru-RU-SvetlanaNeural
TTS_VOICE_EN=en-US-JennyNeural
TTS_RATE=-8%
TTS_PITCH=+4%

# Bir soatda nechta YANGI klip generatsiya qilinishi mumkin. Keshdan olingan
# ovoz bu hisobga kirmaydi, shuning uchun odatdagi ishlatishda chegaraga
# yaqinlashilmaydi — u faqat xato yoki suiiste'mol holatida hisobni himoya qiladi.
TTS_HOURLY_BUDGET=500
